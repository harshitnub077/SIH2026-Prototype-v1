# ==============================================================================
# MetroLens Backend Environment Configuration (.env.example)
# SIH26034 — Legal Metrology Compliance Checker
# Ministry of Consumer Affairs, Food & Public Distribution, Govt. of India
# ==============================================================================
# Copy this file to .env:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SERVER CONFIGURATION
# ------------------------------------------------------------------------------
# Default port is 5001 (Port 5000 is reserved by macOS AirPlay ControlCenter)
PORT=5001
NODE_ENV=development

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# Option A (Local Offline SQLite - Recommended for quick local hackathon testing):
# MetroLens automatically uses SQLite (test.sqlite) if DATABASE_URL is unset.
USE_SQLITE=true
DB_DIALECT=sqlite

# Option B (PostgreSQL via Connection URL - Neon / Supabase / Render):
# Get free serverless Postgres at: https://neon.tech or https://supabase.com
# DATABASE_URL=postgresql://user:password@ep-sample-123.ap-southeast-1.aws.neon.tech/metrolens?sslmode=require

# Option C (PostgreSQL via individual parameters):
DB_HOST=localhost
DB_PORT=5432
DB_NAME=metrolens
DB_USER=postgres
DB_PASSWORD=postgres

# ------------------------------------------------------------------------------
# 3. SECURITY & AUTHENTICATION (JWT)
# ------------------------------------------------------------------------------
# Secret key used for signing enforcement officer session tokens.
# Replace with any strong random string (e.g. openssl rand -hex 32)
JWT_SECRET=metrolens_sih26034_secure_officer_secret_key_2026
JWT_EXPIRES_IN=24h

# ------------------------------------------------------------------------------
# 4. MULTIMODAL AI & VISION OCR APIS (OPTIONAL - FALLBACK PIPELINE)
# ------------------------------------------------------------------------------
# Note: MetroLens includes Tesseract OCR which runs 100% locally and offline.
# The AI models below are used for high-accuracy fallback and clause analysis.

# [A] Google Gemini Vision API (Primary Multimodal AI)
# Where to get key: https://aistudio.google.com/app/apikey (100% Free with Google Account)
# Models used: gemini-2.5-flash / gemini-1.5-flash
GEMINI_API_KEY=your_gemini_api_key_here

# [B] Groq Cloud API (Ultra-Fast LPU Vision Inference)
# Where to get key: https://console.groq.com/keys (100% Free Tier with high rate limits)
# Models used: llama-3.2-11b-vision-preview / llama-3.2-90b-vision-preview
GROQ_API_KEY=your_groq_api_key_here

# [C] NVIDIA NIM API (Enterprise Vision Fallback)
# Where to get key: https://build.nvidia.com/explore/discover (Free 1,000 credits upon signup)
# Models used: nvidia/neva-22b / meta/llama-3.2-11b-vision-instruct
NVIDIA_API_KEY=your_nvidia_api_key_here

# ------------------------------------------------------------------------------
# 5. CLOUD STORAGE (OPTIONAL - SUPABASE)
# ------------------------------------------------------------------------------
# Used for archiving original label scans and generating evidence CDN links.
# Where to get: https://supabase.com/dashboard -> Project Settings -> API
# If left blank, MetroLens saves uploaded evidence to the local './uploads' folder.
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-supabase-anon-key-here

# ------------------------------------------------------------------------------
# 6. FILE STORAGE & OCR SETTINGS
# ------------------------------------------------------------------------------
# Local directory for temporary storage of uploaded images
UPLOAD_DIR=./uploads
# Maximum allowed scan upload payload size in megabytes
MAX_FILE_SIZE_MB=10
# Tesseract OCR confidence score (0-100) below which Vision AI fallback is triggered
OCR_CONFIDENCE_THRESHOLD=60
